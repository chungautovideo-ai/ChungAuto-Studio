# ── ElevenLabs TTS (bắt buộc để tạo voiceover) ───────────────────────────
# Lấy key tại: https://elevenlabs.io/  → Profile → API Keys
ELEVENLABS_API_KEY=sk_your_key_here

# Voice ID (tùy chọn). Mặc định "pNInz6obpgDQGcFmaJgB" (Adam — giọng nam).
# Đổi sang voice của bạn: ElevenLabs → Voices → mở voice → copy Voice ID.
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Model (tùy chọn). Mặc định eleven_v3 (có native word-alignment).
ELEVENLABS_MODEL_ID=eleven_v3

# Tuỳ chọn: cho nút "Nhờ AI sửa" trong editor (không cần nếu máy có Claude Code CLI)
ANTHROPIC_API_KEY=

# Tuỳ chọn: thư viện mẫu video online (catalog.json + <id>/template.json, SKILL.md, preview.mp4, poster.jpg)
LIBRARY_URL=

# Windows: đường dẫn whisper-cli.exe (skill /setup-kit tự điền)
HYPERFRAMES_WHISPER_PATH=

# Địa chỉ máy chủ tài khoản (cloud/server.mjs). Bản phát hành dùng updateUrl trong editor/version.json.
CLOUD_URL=
