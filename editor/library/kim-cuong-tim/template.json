ection:column;gap:32px}\n.kc-ds b{display:block;padding:24px 0;border-radius:12px;border:4px solid #fff;background:rgba(80,70,200,.55);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);text-align:center;font-family:\"Inter Tight\",sans-serif;font-weight:400;font-size:62px;color:#fff;box-shadow:0 0 18px rgba(255,255,255,.7)}"
