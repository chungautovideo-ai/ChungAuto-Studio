    "css": ".th-beat{position:absolute;left:60px;right:60px;top:var(--th-y,915px);display:flex;flex-direction:column;align-items:center;text-align:center}\n.th-line{font-family:var(--f-sub);font-weight:500;font-size:62px;line-height:1.15;color:#fff;letter-spacing:-.01em;text-shadow:0 2px 14px rgba(0,0,0,.35)}\n.th-line .w{opacity:.32;display:inline-block}\n.th-key{font-family:var(--f-title);font-weight:900;font-size:200px;line-height:.92;letter-spacing:-.045em;color:#E3C06F;margin:2px 0 0;transform-origin:50% 70%;text-shadow:0 6px 30px rgba(0,0,0,.25);white-space:nowrap}\n.th-key.sm{font-size:140px}\n.th-panel{margin-top:50px;min-width:560px;padding:30px 44px;border-radius:40px;background:rgba(11,10,19,.92);border:2px solid rgba(255,255,255,.16);box-shadow:0 20px 50px rgba(0,0,0,.45),inset 0 1px 0 rgba(255,255,255,.06);display:flex;align-items:center;justify-content:center;gap:26px;color:#fff;font-family:var(--f-label)}\n.th-panel.wide{width:740px}\n.th-stars{display:flex;gap:12px}\n.th-stars i{width:40px;height:40px;background:#3a3946;clip-path:polygon(50% 0,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%)}\n.th-stars i.on{background:#E3C06F}\n.th-num{font-weight:800;font-size:46px;font-variant-numeric:tabular-nums;min-width:90px;text-align:right}\n.th-lab{display:flex;flex-direction:column;align-items:flex-start;gap:4px}\n.th-lab small{font-weight:800;font-size:22px;letter-spacing:.14em;text-transform:uppercase;color:#d8d8e0}\n.th-lab b{font-weight:800;font-size:44px;font-variant-numeric:tabular-nums}\n.th-wave{display:flex;align-items:center;gap:9px;height:70px}\n.th-wave i{width:8px;height:60px;border-radius:5px;background:#fff;transform-origin:50% 50%}\n.th-chips{display:flex;gap:16px;margin-top:38px}\n.th-chip{width:246px;padding:30px 10px 26px;border-radius:26px;background:rgba(11,10,19,.92);border:2px solid rgba(255,255,255,.16);display:flex;flex-direction:column;align-items:center;gap:10px;color:#fff;font-family:var(--f-label);font-weight:700;font-size:26px}\n.th-chip .ck{width:46px;height:46px;border-radius:50%;background:#E3C06F;display:grid;place-items:center}\n.th-chip .ck::after{content:\"\";width:18px;height:9px;border-left:5px solid #0b0a13;border-bottom:5px solid #0b0a13;transform:translateY(-3px) rotate(-45deg)}\n.th-chip small{font-size:20px;color:#bdbdc6;font-weight:600}\n.th-track{position:relative;width:560px;height:10px;border-radius:6px;background:#2e2d3a}\n.th-track b{position:absolute;left:0;top:0;bottom:0;width:30%;border-radius:6px;background:linear-gradient(90deg,#6b6bd6,#a9a9ff)}\n.th-track i{position:absolute;left:30%;top:50%;width:34px;height:34px;margin:-17px 0 0 -17px;border-radius:50%;background:#fff;box-shadow:0 0 0 8px rgba(255,255,255,.18)}\n.th-people{display:flex;gap:14px}\n.th-people i{position:relative;width:42px;height:54px;display:block}\n.th-people i::before,.th-people i::after,.th-people b::before,.th-people b::after{content:\"\";position:absolute;left:50%;box-sizing:border-box}\n.th-people i::before{top:0;width:24px;height:24px;margin-left:-12px;border-radius:50%;border:4px solid #8a8a96}\n.th-people i::after{bottom:0;width:42px;height:26px;margin-left:-21px;border-radius:21px 21px 7px 7px;border:4px solid #8a8a96}\n.th-people b{position:absolute;inset:0;opacity:0}\n.th-people b::before{top:0;width:24px;height:24px;margin-left:-12px;border-radius:50%;background:#E3C06F}\n.th-people b::after{bottom:0;width:42px;height:26px;margin-left:-21px;border-radius:21px 21px 7px 7px;background:#E3C06F}\n.th-people i.on b{opacity:1}\n.th-cmp{display:flex;gap:22px;margin-top:70px}\n.th-cmp>div{width:372px;padding:30px 30px 34px;border-radius:30px;background:rgba(11,10,19,.92);border:2px solid rgba(255,255,255,.16);font-family:var(--f-label);color:#fff;text-align:left}\n.th-cmp small{display:block;font-weight:800;font-size:22px;letter-spacing:.12em;text-transform:uppercase}\n.th-cmp em{display:block;font-style:normal;font-weight:700;font-size:17px;letter-spacing:.12em;color:#bdbdc6;margin-top:6px}\n.th-cmp b{display:block;font-weight:900;font-size:70px;line-height:1.05;margin-top:6px;font-variant-numeric:tabular-nums}\n.th-cmp .bad b{color:#E3C06F}\n.th-card{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;font-family:var(--f-title)}\n.th-card.gold{background:#E3BE6E;color:#121014}\n.th-card.gray{background:#ADADAD;color:#121014}\n.th-card .big{font-weight:900;font-size:200px;letter-spacing:-.045em;line-height:.95}\n.th-card .sub{font-family:var(--f-sub);font-weight:500;font-size:62px}\n.th-bubble{width:140px;height:84px;border-radius:42px;background:#fff;display:flex;align-items:center;justify-content:center;gap:12px;margin-bottom:20px}\n.th-bubble i{width:16px;height:16px;border-radius:50%;background:#121014}\n.th-grid{display:grid;grid-template-columns:repeat(6,80px);gap:26px 46px;margin-bottom:60px}\n.th-grid i{position:relative;width:56px;height:76px;margin:0 auto;--gc:#121014}\n.th-grid i::before,.th-grid i::after{content:\"\";position:absolute;left:50%;background:var(--gc)}\n.th-grid i::before{top:0;width:32px;height:32px;margin-left:-16px;border-radius:50%}\n.th-grid i::after{bottom:0;width:56px;height:38px;margin-left:-28px;border-radius:28px 28px 9px 9px}\n.th-grid i.on{--gc:#E3BE6E}\n.th-pill{padding:16px 46px;border-radius:999px;background:#E3BE6E;color:#121014;font-weight:900;font-size:76px;letter-spacing:-.03em;box-shadow:0 10px 30px rgba(0,0,0,.18)}\n.th-card .note{font-family:var(--f-sub);font-weight:500;font-size:44px;color:#2a2a2e}"
